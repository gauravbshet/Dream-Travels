# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials.

# --- Supabase (required) ---
# Project Settings -> API in the Supabase dashboard.
# The app throws immediately at startup if either of these is missing
# (see src/lib/supabase.client.ts and src/lib/supabase.server.ts).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key, used only for privileged admin-side operations
# (src/lib/supabase.server.ts -> createAdminSupabaseClient). Keep this
# secret — it bypasses Row Level Security. Falls back to the anon key
# if unset, which will fail for anything that actually needs elevated
# privileges.
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional ---
# Public site URL used for metadata/canonical links and sitemap entries.
# Defaults to https://dreamtravels.com if unset.
NEXT_PUBLIC_SITE_URL=

# WhatsApp number used for booking/enquiry CTAs (digits only, with
# country code, e.g. 91XXXXXXXXXX). Falls back to a hardcoded default
# in the booking and package pages if unset.
NEXT_PUBLIC_WHATSAPP_NUMBER=
